'use client';

import { Canvas, useFrame, useRef } from '@react-three/fiber';
import { Points, PointMaterial, TorusKnot } from '@react-three/drei';
import { Suspense } from 'react';
import { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import Image from 'next/image';
import { decorCatalog, rentalCatalog } from '@/data/catalog';

const SkeletonLoader = () => (
  <div className="flex items-center justify-center h-screen bg-obsidian text-gold">
    <div className="w-16 h-16 rounded-full bg-gold opacity-30 animate-shimmer" />
  </div>
);

const CelebrationRing = () => (
  <mesh rotation={[0, Math.PI / 2, 0]}>
    <TorusKnot args={[0.5, 0.2, 0.5, 128, 32, true]} />
    <meshStandardMaterial color="#D4AF37" metalness={0.9} roughness={0.15} />
  </mesh>
);

const FloatingBalloon = ({ position, color, id }: { position: [number, number, number]; color: string; id: string }) => (
  <mesh position={position}>
    <sphereGeometry args={[0.07, 32, 32]} />
    <meshStandardMaterial color={color} metalness={0.8} roughness={0.2} />
  </mesh>
);

const GoldDustParticles = ({ positions, mood }: { positions: number[]; mood: string }) => {
  const particleCount = positions.length / 3;
  return (
    <group>
      <Points
        positions={positions}
        size={0.02}
        sizeAttenuation
        className="point-soft"
      >
        <PointMaterial
          color="#D4AF37"
          size={0.02}
          sizeAttenuation
          transparent
          opacity={0.6}
        />
      </Points>
      {mood === 'spark' && (
        <Points
          positions={positions}
          size={0.015}
          sizeAttenuation
        >
          <PointMaterial
            color="#FFFFFF"
            size={0.015}
            sizeAttenuation
            transparent
            opacity={0.8}
          />
        </Points>
      )}
    </group>
  );
};

const TrendingCard = () => (
  <motion.div
    className="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 bg-obsidian/80 backdrop-blur-xl border border-gold/30 rounded-2xl p-5 w-full max-w-sm shadow-2xl shadow-black/50"
    initial={{ opacity: 0, y: 20 }}
    whileInView={{ opacity: 1, y: 0 }}
    viewport={{ once: true }}
  >
    <h3 className="font-serif text-lg text-gold mb-3 text-center">Trending Setup</h3>
    <div className="space-y-3 max-h-48 overflow-y-auto">
      {decorCatalog.slice(0, 2).map((item) => (
        <motion.div
          key={item.id}
          className="flex gap-3"
          initial={{ opacity: 0, x: -20 }}
          whileInView={{ opacity: 1, x: 0 }}
          transition={{ duration: 0.4 }}
        >
          <div className="aspect-square w-14 h-14 bg-white/5 border border-white/10 rounded-lg overflow-hidden flex-shrink-0">
            <Image
              src={item.localAsset || `https://lh3.googleusercontent.com/d/${item.driveId}`}
              alt={item.title}
              fill
              className="w-full h-full object-cover"
            />
          </div>
          <div className="flex-1 min-w-0">
            <p className="text-white font-medium truncate text-sm">{item.title}</p>
            {item.price && <p className="text-gold text-xs">{item.price}</p>}
          </div>
        </motion.div>
      ))}
    </div>
  </motion.div>
);

const MoodSelector = ({ currentMood, onChange }: { currentMood: string; onChange: (id: string) => void }) => {
  const presets = [
    { id: 'royal', label: 'Royal Midnight', color: '#D4AF37' },
    { id: 'warm', label: 'Warm Traditional', color: '#FFBF00' },
    { id: 'spark', label: 'Celebration Spark', color: '#F5C542' },
  ];
  return (
    <div className="absolute top-4 left-1/2 -translate-x-1/2 z-10 flex space-x-2">
      {presets.map((p) => (
        <motion.button
          key={p.id}
          onClick={() => onChange(p.id)}
          className={`px-4 py-2 rounded-full text-sm font-medium transition-all ${
            currentMood === p.id
              ? 'bg-gold text-obsidian shadow-lg shadow-gold/30'
              : 'bg-white/10 text-white hover:bg-white/20'
          }`}
          whileHover={{ scale: 1.05 }}
          whileTap={{ scale: 0.95 }}
        >
          {p.label}
        </motion.button>
      ))}
    </div>
  );
};

const Scene = () => {
  const mouse = useRef({ x: 0, y: 0 });
  const sphereRefs = useRef<Array<{ angle: number; radius: number; mesh: any }>>([]);
  const particlePositions = useRef<Float32Array>(new Float32Array(150 * 3));
  const [mood, setMood] = useState('royal');
  const [initialized, setInitialized] = useState(false);

  useEffect(() => {
    const handleMove = (e: MouseEvent) => {
      mouse.current = {
        x: (e.clientX / window.innerWidth) * 2 - 1,
        y: -(e.clientY / window.innerHeight) * 2 + 1,
      };
    };
    window.addEventListener('pointermove', handleMove);
    return () => window.removeEventListener('pointermove', handleMove);
  }, []);

  useEffect(() => {
    const positions = particlePositions.current;
    for (let i = 0; i < 150; i++) {
      const angle = (i / 150) * Math.PI * 2;
      const radius = 1.5 + Math.random() * 0.5;
      positions[i * 3] = Math.cos(angle) * radius;
      positions[i * 3 + 1] = Math.sin(angle) * radius;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 0.5;
    }
    setInitialized(true);
  }, []);

  useFrame((state) => {
    const time = state.clock.getElapsedTime();
    const mx = mouse.current.x;
    const my = mouse.current.y;

    sphereRefs.current.forEach((s) => {
      const angle = time + s.angle + mx * 0.3;
      const x = Math.cos(angle) * s.radius;
      const y = Math.sin(angle) * s.radius;
      if (s.mesh) {
        s.mesh.position.set(x, y, 0);
      }
    });

    const positions = particlePositions.current;
    for (let i = 0; i < 150; i++) {
      const angle = time * 0.5 + i * 0.1 + mx * 0.5;
      const radius = 1.5 + my * 0.3;
      positions[i * 3] = Math.cos(angle) * radius;
      positions[i * 3 + 1] = Math.sin(angle) * radius;
      positions[i * 3 + 2] = Math.sin(time + i * 0.2) * 0.3;
    }
    state.gl.attributes.position.needsUpdate = true;
  });

  const sphereData = [
    { id: 's1', angle: 0, radius: 1.2 },
    { id: 's2', angle: 0.5, radius: 1.4 },
    { id: 's3', angle: 1.0, radius: 1.0 },
    { id: 's4', angle: 1.5, radius: 1.6 },
    { id: 's5', angle: 2.0, radius: 1.1 },
    { id: 's6', angle: 2.5, radius: 1.3 },
  ];

  const moodColors = {
    royal: '#D4AF37',
    warm: '#FFBF00',
    spark: '#F5C542',
  };

  return (
    <group>
      <ambientLight intensity={0.5} />
      <pointLight position={[10, 10, 10]} color="#D4AF37" intensity={1} />
      <CelebrationRing />

      <group>
        {sphereData.map((s, i) => (
          <FloatingBalloon
            key={s.id}
            position={[0, 0, 0]}
            color={moodColors[mood as keyof typeof moodColors]}
            id={s.id}
            ref={(mesh) => { if (mesh) sphereRefs.current[i] = { ...s, mesh }; }}
          />
        ))}
      </group>

      <GoldDustParticles positions={Array.from(particlePositions.current)} mood={mood} />
      <TrendingCard />
    </group>
  );
};

const Party3DHero = () => {
  const [mood, setMood] = useState('royal');

  return (
    <section className="relative h-screen w-full bg-obsidian overflow-hidden">
      {/* Video Background Layer */}
      <video
        autoPlay
