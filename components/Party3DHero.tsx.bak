        muted
        playsInline
        className="absolute inset-0 w-full h-full object-cover -z-10 opacity-40 mix-blend-screen"
        poster="/assets/og-party-partners.png"
      >
        <source src="/hero-bg.mp4" type="video/mp4" />
      </video>

      {/* Dark Gradient Overlay - from obsidian at bottom to transparent at top */}
      <div className="absolute inset-0 -z-10 bg-gradient-to-t from-obsidian via-obsidian/60 to-transparent" />

      {/* Three.js Canvas Overlay */}
      <MoodSelector currentMood={mood} onChange={setMood} />
      <Suspense fallback={<SkeletonLoader />}>
